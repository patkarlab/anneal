#!/bin/bash
#PBS -N anneal_cohort
#PBS -q A40b
#PBS -l select=1:ncpus=16:ngpus=1:mem=100gb
#PBS -l walltime=36:00:00
#PBS -j oe
#PBS -o /home/patkarlab-clinical/pipelines/anneal/logs/

# Cohort run: the single-sample front-door job as an array over a manifest.
#
#   ls /scratch/.../<batch>/*_R1_001.fastq.gz | sed 's#.*/##; s#_R1_001.fastq.gz##' > cohort.manifest
#   N=$(wc -l < cohort.manifest)
#   qsub -J 0-$((N-1)) -v MANIFEST=$PWD/cohort.manifest,OUT=/scratch/patkarlab-clinical/<outdir>,FQ=/scratch/patkarlab-clinical/<batch> jobs/anneal_cohort.pbs
#
# Each subjob takes one manifest line (a FASTQ name up to _R1_001.fastq.gz),
# waits until /scratch has at least 220 GB free (each stage 1 needs 100-184 GB
# transient, so this throttles concurrency by disk), then runs
# run_pipeline.sh --stages 1,2,3,4,5 with no overrides. alignment/ is removed
# on success only. Rerun a failed index with -J i-i.
#
# Queue: A40b has one GPU, a40 has two nodes with two each; submit to
# whichever is free (edit -q). Two samples at a time is what the disk allows.

ANNEAL_ROOT=/home/patkarlab-clinical/pipelines/anneal
cd "${ANNEAL_ROOT}"
source pipeline/config.sh
activate_conda
module load apptainer/1.5.1

MANIFEST="${MANIFEST:?-v MANIFEST=<file with one FULL name per line>}"
OUT="${OUT:?-v OUT=<output directory>}"
FQ="${FQ:-/scratch/patkarlab-clinical/Duplex_dilutions}"
IDX="${PBS_ARRAY_INDEX:?run as an array: -J 0-N}"

FULL=$(sed -n "$((IDX + 1))p" "${MANIFEST}")
[ -n "${FULL}" ] || { echo "ERROR: no manifest line for index ${IDX}"; exit 1; }
NAME="${FULL%_S*}"
# FASTQ suffixes: Illumina default _R1_001.fastq.gz; override for other
# naming, e.g. -v R1_SUFFIX=_R1.fastq.gz,R2_SUFFIX=_R2.fastq.gz
R1_SUFFIX="${R1_SUFFIX:-_R1_001.fastq.gz}"
R2_SUFFIX="${R2_SUFFIX:-_R2_001.fastq.gz}"
R1="${FQ}/${FULL}${R1_SUFFIX}"
R2="${FQ}/${FULL}${R2_SUFFIX}"

echo "index:   ${IDX}"
echo "sample:  ${NAME}"
echo "host:    $(hostname)"
echo "commit:  $(git -C "${ANNEAL_ROOT}" describe --tags --always 2>/dev/null || cat "${ANNEAL_ROOT}/.git/$(sed "s/ref: //" "${ANNEAL_ROOT}/.git/HEAD")" 2>/dev/null | cut -c1-7)"
echo "binary:  ${ANNEAL}"
echo "aligner: ${ALIGNER} ${PARABRICKS_FLAGS} ${ALIGNER_ARGS}"
echo "start:   $(date)"
for f in "${R1}" "${R2}"; do
    [ -f "${f}" ] || { echo "ERROR: missing ${f}"; exit 1; }
done
if [ -f "${OUT}/${NAME}/scored/${NAME}.dcs.calls.tsv" ]; then
    echo "already complete: ${OUT}/${NAME}; nothing to do"
    exit 0
fi

# Wait for headroom rather than fail: other subjobs are consuming and
# releasing transient space. Give up after 24 h.
headroom() {
    local used hard
    used=$(lfs quota -u "$USER" /scratch 2>/dev/null | awk 'NR==3{gsub(/\*/,"",$2); print $2}')
    hard=$(lfs quota -u "$USER" /scratch 2>/dev/null | awk 'NR==3{print $4}')
    echo $(( (hard - used) / 1048576 ))
}
waited=0
while [ "$(headroom)" -lt 220 ]; do
    if [ "${waited}" -eq 0 ]; then echo "waiting for /scratch headroom ($(headroom) GB free)"; fi
    sleep 300; waited=$((waited + 300))
    if [ "${waited}" -ge 86400 ]; then echo "ERROR: no headroom after 24 h"; exit 75; fi
done
echo "scratch headroom: $(headroom) GB after ${waited}s wait"
mkdir -p "${OUT}"

bash pipeline/run_pipeline.sh "${NAME}" "${R1}" "${R2}" "${OUT}" --stages 1,2,3,4,5
rc=$?
echo "run_pipeline exit: ${rc}   end: $(date)"
if [ "${rc}" -eq 0 ]; then
    rm -rf "${OUT}/${NAME}/alignment"
    echo "alignment/ removed"
fi
du -sh "${OUT}/${NAME}" 2>/dev/null
exit "${rc}"
