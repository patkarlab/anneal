#!/bin/bash
#PBS -N anneal_01_gpu
#PBS -q a40
#PBS -l select=1:ncpus=16:ngpus=1:mem=120gb
#PBS -l walltime=24:00:00
#PBS -o /home/patkarlab-clinical/pipelines/anneal/results_gpu/gpu_pbs.out
#PBS -e /home/patkarlab-clinical/pipelines/anneal/results_gpu/gpu_pbs.err
#PBS -m ae
cd /home/patkarlab-clinical/pipelines/anneal
module load cuda/12.3
source /home/patkarlab-clinical/.cargo/env
eval "$(/home/patkarlab-clinical/miniconda3/bin/conda shell.bash hook)"
conda activate anneal
mkdir -p /home/patkarlab-clinical/pipelines/anneal/results_gpu
# temporarily run with USE_GPU=true via env override is not supported; set in config below
bash pipeline/run_pipeline.sh \
    DX-2-Duplex \
    /home/patkarlab-clinical/pipelines/anneal/sample_fastq/DX-2-Duplex_S1_R1_001.fastq.gz \
    /home/patkarlab-clinical/pipelines/anneal/sample_fastq/DX-2-Duplex_S1_R2_001.fastq.gz \
    /home/patkarlab-clinical/pipelines/anneal/results_gpu \
    --stages 1,2
echo "GPU run complete: $(date)"
