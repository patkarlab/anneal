#!/bin/bash
#PBS -N anneal_01_test
#PBS -q long
#PBS -l nodes=1:ppn=16
#PBS -l mem=120gb
#PBS -l walltime=48:00:00
#PBS -o /home/patkarlab-clinical/pipelines/anneal/results/test_pbs.out
#PBS -e /home/patkarlab-clinical/pipelines/anneal/results/test_pbs.err
#PBS -m ae
cd /home/patkarlab-clinical/pipelines/anneal
source /home/patkarlab-clinical/.cargo/env
eval "$(/home/patkarlab-clinical/miniconda3/bin/conda shell.bash hook)"
conda activate anneal
mkdir -p /home/patkarlab-clinical/pipelines/anneal/results
bash pipeline/run_pipeline.sh \
    DX-2-Duplex \
    /home/patkarlab-clinical/pipelines/anneal/sample_fastq/DX-2-Duplex_S1_R1_001.fastq.gz \
    /home/patkarlab-clinical/pipelines/anneal/sample_fastq/DX-2-Duplex_S1_R2_001.fastq.gz \
    /home/patkarlab-clinical/pipelines/anneal/results \
    --stages 1,2
echo "Run complete: $(date)"
